{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(type *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(where *)",
      "Bash(which *)",
      "Bash(monid *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(runas *)",
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(reg delete *)",
      "Bash(shutdown *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(iwr * | iex)",
      "Read(./.env)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/credentials.json)",
      "Read(**/token.json)",
      "Edit(**/.ssh/**)"
    ]
  }
}
